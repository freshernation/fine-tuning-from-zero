# Copy this file to .env and fill in ONE provider. Never commit .env.
#
#   fake    - no key, no network, no cost. The default. Every test uses it.
#   claude  - needs ANTHROPIC_API_KEY
#   openai  - needs OPENAI_API_KEY
AGENT_PROVIDER=fake

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: which model each provider uses. Leave blank for the course default.
AGENT_CLAUDE_MODEL=
AGENT_OPENAI_MODEL=
